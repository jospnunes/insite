  "Cart Functionality": {
    "cats": [
      6
    ],
    "description": "Websites that have a shopping cart or checkout page, either using a known ecommerce platform or a custom solution.",
    "dom": [
      "a[href$='/cart']",
      "a[href*='/cart/']",
      "a[href*='/cart?']",
      "a[href*='/cart#']",
      "a[href*='/order']",
      "a[href*='/basket']",
      "a[href*='/trolley']",
      "a[href*='/bag/']",
      "a[href*='/shoppingbag']",
      "a[href*='/checkout']",
      "a[href*='/winkelwagen']",
      "[aria-controls='cart']",
      "[class*='shopping-bag']",
      "[class*='shopping-cart']",
      "[class*='checkout']",
      "[class*='winkelwagen']"
    ],
    "icon": "Cart-generic.svg",
    "js": {
      "google_tag_params.ecomm_pagetype": ""
    },
    "scriptSrc": [
      "googlecommerce\\.com/trustedstores/api/js"
    ],
    "url": [
      "/(?:cart|order|basket|trolley|bag|shoppingbag|checkout)(?:[/?#]|$)"
    ],
    "website": "https://en.wikipedia.org/wiki/Shopping_cart_software"
  },
