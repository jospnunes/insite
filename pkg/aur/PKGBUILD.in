# Maintainer: José Pedro Pereira <contato at synthsolutions dot com dot br>
# Generated by pkg/aur/render.sh at release time; do not edit the copy on the AUR by hand.
pkgname=insite-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Full X-ray of a website from the terminal: network, TLS, DNS, stack, security, SEO and weight'
arch=('x86_64' 'aarch64')
url='https://github.com/jospnunes/insite'
license=('GPL-3.0-or-later')
optdepends=('chromium: --browser mode (Core Web Vitals)')
provides=('insite')
conflicts=('insite')
# The released binary is prebuilt: no separate -debug package.
options=('!debug')
source_x86_64=("insite-@VERSION@-x86_64.tar.xz::https://github.com/jospnunes/insite/releases/download/v@VERSION@/insite-x86_64-unknown-linux-musl.tar.xz")
source_aarch64=("insite-@VERSION@-aarch64.tar.xz::https://github.com/jospnunes/insite/releases/download/v@VERSION@/insite-aarch64-unknown-linux-musl.tar.xz")
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
  # cargo-dist unpacks into a directory named after the archive, without the extension.
  cd "$srcdir/insite-$CARCH-unknown-linux-musl"
  install -Dm755 insite "$pkgdir/usr/bin/insite"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
